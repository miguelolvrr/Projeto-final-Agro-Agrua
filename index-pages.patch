<body>
<script src="municipios_pi.js"></script>
<script src="base_dados.js"></script>
<script src="i18n.js"></script>
<script src="database.js"></script>
<script src="saas.js"></script>
<script>
(function () {
  if (!location.hash) {
    try { history.replaceState(null, '', location.pathname + location.search + '#overview'); }
    catch (error) { location.hash = 'overview'; }
  }
  try {
    const key = 'agroagua_saas_demo_session';
    const current = JSON.parse(localStorage.getItem(key) || 'null');
    if (!current || !current.exp || current.exp <= Date.now()) {
      localStorage.setItem(key, JSON.stringify({ username: 'agricultor', exp: Date.now() + 8 * 60 * 60 * 1000 }));
    }
  } catch (error) {}
})();
</script>
